{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-quiver.github.io/schemas/v1/manifest.schema.json",
  "title": "Quiver artifact manifest (quiver.yaml)",
  "description": "Protocol-neutral contract for one registry artifact. Manifest spec v0.2: a MINOR is additive, a MAJOR is breaking and ships a migration.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "version",
    "description",
    "owner",
    "lifecycle",
    "audience"
  ],
  "properties": {
    "id": {
      "description": "Stable dotted identifier, e.g. python.fastapi.scaffold. Never reused.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$"
    },
    "kind": {
      "enum": [
        "skill",
        "tool",
        "workflow",
        "resource",
        "agent_profile"
      ]
    },
    "version": {
      "description": "Semantic version of the artifact content/contract.",
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z.-]+)?$"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "minLength": 20
    },
    "card": {
      "description": "What a search result shows: one line saying when to use the artifact and its key precondition. At most 40 tokens (characters / 4); without it, search shows the description cut to that budget. Added in v0.2.",
      "type": "string",
      "minLength": 10,
      "maxLength": 160,
      "pattern": "^[^\\n]+$"
    },
    "discovery": {
      "description": "How agents phrase the task this artifact serves. `queries`: 2-5 natural-language queries, each at most 20 tokens (characters / 4), indexed by search and never served in results. Maps to ARD representativeQueries. Added in v0.3.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "queries"
      ],
      "properties": {
        "queries": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 8,
            "maxLength": 80,
            "pattern": "^[^\\n]+$"
          }
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "owner": {
      "description": "Person or team accountable for the artifact.",
      "type": "string"
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "draft",
            "reviewed",
            "published",
            "deprecated",
            "retired"
          ]
        },
        "replaced_by": {
          "type": "string"
        },
        "sunset": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "audience": {
      "description": "Publication audiences. Separate publications, not search filters.",
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "internal",
          "client",
          "public"
        ]
      },
      "uniqueItems": true
    },
    "dependencies": {
      "description": "Other artifacts this one uses, with semver ranges. Dependencies never widen permissions.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "range"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "range": {
            "type": "string"
          }
        }
      }
    },
    "compatibility": {
      "description": "Toolchain or platform constraints, e.g. {\"python\": \">=3.11\"}.",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "requires": {
      "description": "Permissions the artifact NEEDS. Requirements, never grants.",
      "type": "array",
      "items": {
        "enum": [
          "filesystem.read",
          "filesystem.write",
          "shell.execute",
          "network.egress",
          "git.read",
          "git.write",
          "secrets.read",
          "infra.read",
          "infra.write"
        ]
      },
      "uniqueItems": true
    },
    "contract": {
      "description": "Tools/workflows: the capability contract shared with the Agent Bridge.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input": {
          "description": "JSON Schema of the input.",
          "type": "object"
        },
        "output": {
          "description": "JSON Schema of the output.",
          "type": "object"
        },
        "side_effects": {
          "enum": [
            "none",
            "read",
            "write",
            "external"
          ]
        },
        "idempotent": {
          "type": "boolean"
        },
        "audit_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "content",
            "agent",
            "isolated",
            "provider"
          ]
        },
        "runtime": {
          "description": "Runtime image/version, released separately from content.",
          "type": "string"
        },
        "provider": {
          "description": "Provider that executes it, when mode = provider.",
          "type": "string"
        },
        "timeout_s": {
          "type": "integer",
          "minimum": 1
        },
        "limits": {
          "type": "object"
        }
      }
    },
    "steps": {
      "description": "Workflows: ordered artifact ids.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "entrypoint": {
      "description": "Relative path of the main file (default SKILL.md for skills).",
      "type": "string"
    },
    "provenance": {
      "description": "Where an imported artifact came from, for drift detection against the source.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo",
        "path",
        "commit",
        "sha256"
      ],
      "properties": {
        "repo": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "sha256": {
          "description": "sha256 of the SOURCE at import time (sorted path + content).",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "imported": {
          "type": "string",
          "format": "date"
        },
        "mode": {
          "description": "verbatim: Quiver copy equals the source; adapted: deliberately edited after import.",
          "enum": [
            "verbatim",
            "adapted"
          ]
        },
        "also_from": {
          "description": "Further sources merged into this artifact (ADR-0004).",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "repo",
              "path",
              "commit",
              "sha256"
            ],
            "properties": {
              "repo": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "commit": {
                "type": "string",
                "pattern": "^[0-9a-f]{7,40}$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "as": {
                "description": "Where it landed in the artifact, e.g. reference.md.",
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "tool"
            ]
          }
        }
      },
      "then": {
        "required": [
          "contract",
          "execution"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "workflow"
          }
        }
      },
      "then": {
        "required": [
          "steps"
        ]
      }
    }
  ]
}
